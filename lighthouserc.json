{
  "ci": {
    "collect": {"staticDistDir": "dist", "url": ["http://localhost/index.html", "http://localhost/espanol.html"], "numberOfRuns": 3},
    "assert": {"assertions": {"categories:performance": ["error", {"minScore": 0.95}], "categories:accessibility": ["error", {"minScore": 1}], "categories:best-practices": ["error", {"minScore": 1}], "largest-contentful-paint": ["error", {"maxNumericValue": 2500}], "first-contentful-paint": ["error", {"maxNumericValue": 1500}], "total-blocking-time": ["error", {"maxNumericValue": 50}], "cumulative-layout-shift": ["error", {"maxNumericValue": 0}]}},
    "upload": {"target": "filesystem", "outputDir": "test-results/lighthouse"}
  }
}
